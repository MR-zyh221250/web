{
    admin off
}
neon-loft-zyh.duckdns.org {
    @guest path /api/public/* /api/register /api/login /api/logout /api/me /api/password /api/reservations /api/reservations/* /api/media /api/media/* /api/customers/*/avatar
    handle @guest {
        reverse_proxy 127.0.0.1:3000
    }
    handle /api/* {
        respond 404
    }
    handle /manage.html {
        redir https://crm.neon-loft-zyh.duckdns.org/ 308
    }
    handle {
        reverse_proxy 127.0.0.1:8080
    }
}
crm.neon-loft-zyh.duckdns.org {
    handle /api/* {
        reverse_proxy 127.0.0.1:3000
    }
    handle {
        reverse_proxy 127.0.0.1:8081
    }
}
neon-ci-zyh.duckdns.org {
    reverse_proxy 127.0.0.1:8112 {
        header_up X-Forwarded-Port 443
        transport http {
            dial_timeout 30s
            response_header_timeout 1200s
        }
    }
}
